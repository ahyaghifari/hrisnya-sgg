APP_NAME=Laravel
APP_ENV=local
APP_KEY=
PAYROLL_ENCRYPTION_KEY=
PAYROLL_PREVIOUS_KEYS=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=admin
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=10080
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

VAPID_SUBJECT=mailto:you@example.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# URL publik app pelamar (buat tombol CTA di email notifikasi + API pemicu email pelamar).
# Integrasi DATA HRIS <-> Rekrutmen lewat DB_REKRUTMEN_* di bawah; EMAIL pelamar lewat API.
REKRUTMEN_URL=
# Bearer token API rekrutmen (POST /api/integrations/hris/notifications). Harus sama dengan
# REKRUTMEN_API_TOKEN di .env project rekrutmen. Kosong = email pelamar tidak dikirim.
REKRUTMEN_API_TOKEN=

# Shared DB project Rekrutmen — HRIS ambil alih admin rekrutmen, baca-tulis langsung
# ke DB ini (repo `rekrutmen` tetap pemilik skema; HRIS tidak migrate ke sini).
DB_REKRUTMEN_HOST=127.0.0.1
DB_REKRUTMEN_PORT=3306
DB_REKRUTMEN_DATABASE=
DB_REKRUTMEN_USERNAME=
DB_REKRUTMEN_PASSWORD=
# Path storage privat repo rekrutmen (satu server) — offering letter & dokumen kandidat.
# Lokal: d:\Projects\rekrutmen\storage\app\private
REKRUTMEN_STORAGE_PATH=

# Keycloak SSO (opsional). Kosong = tombol "Masuk dengan SSO" tidak berfungsi,
# login lokal (email/NIP + password) tetap jalan.
KEYCLOAK_BASE_URL=
KEYCLOAK_REALM=
KEYCLOAK_CLIENT_ID=
KEYCLOAK_CLIENT_SECRET=
KEYCLOAK_REDIRECT_URI="${APP_URL}/auth/keycloak/callback"
# Keycloak Admin REST API (kelola user Keycloak dari panel HRIS). Pakai client
# "service account" terpisah: aktifkan Service Accounts Enabled + beri role
# realm-management (manage-users, view-users). Kosong = menu Keycloak Users nonaktif.
KEYCLOAK_ADMIN_CLIENT_ID=
KEYCLOAK_ADMIN_CLIENT_SECRET=
